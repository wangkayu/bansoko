# Bansoko deployment environment
# Copy to an untracked .env file and replace every secret before use.

# Compose database coordinates. BANSOKO_DB_USER/PASSWORD are the schema owner
# (POSTGRES_USER/POSTGRES_PASSWORD of the bundled postgres). The app receives
# them as its only database input, BANSOKO_DATABASE_URL; the bootstrap migrates
# with it, converges the fixed runtime login role `bansoko_app` with a generated
# password, and serves with that runtime role. Nothing else is configured.
BANSOKO_DB_NAME=bansoko
BANSOKO_DB_USER=bansoko
BANSOKO_DB_PASSWORD=replace-with-a-long-random-password
BANSOKO_DB_PORT=5432

# Deployment-owned state directory bound at /config. It holds the generated
# secrets (secrets.json: session secret, encryption key, runtime role password);
# keep it with the database.
BANSOKO_CONFIG_DIR=/opt/bansoko/config

# Runtime
BANSOKO_APP_PORT=8000
# Session secret and encryption key are generated into $BANSOKO_CONFIG_DIR/secrets.json
# on first start. Setting them here overrides the stored values (never written
# back to the file).
# BANSOKO_SESSION_SECRET=
# BANSOKO_SECRET_ENCRYPTION_KEY=

# Backups (Settings > Backups) are exported as a download and restored by
# uploading the file; the server keeps none. Backups do not contain the
# encryption key: keep a copy of $BANSOKO_CONFIG_DIR/secrets.json somewhere safe.

# Development fixture only. Production startup rejects this value.
# BANSOKO_SKIP_AUTH=false

# Embedded updates follow one of this project's two published lanes: stable
# (tagged releases) or test (every main build). The lane names the channel
# branch, so there is no update source URL to configure and no credential
# surface: the client always reads the project's public branch anonymously.
# Leave it unset for stable.
# BANSOKO_UPDATE_LANE=stable
# A test instance follows main builds instead:
# BANSOKO_UPDATE_LANE=test
# Release metadata used by the canonical Compose build.
# BANSOKO_VERSION=v2.0.0
# BANSOKO_SOURCE_COMMIT=0123456789abcdef0123456789abcdef01234567
# BANSOKO_BUILD_ID=release-id
# BANSOKO_BUILD_TIME=2026-01-01T00:00:00Z
# BANSOKO_BUILD_DIRTY=false


# Optional production qBittorrent sidecar. The qB connection itself is created
# by the user in WebUI; these variables only select its host config and shared
# Docker volume.
BANSOKO_QB_CONFIG_DIR=/opt/bansoko/qbittorrent/config
BANSOKO_QB_DOWNLOADS_VOLUME=bansoko_downloads
BANSOKO_QB_WEBUI_PORT=8087
# Optional qBittorrent fixture profile. User-facing connection values are
# stored through the V2 WebUI owner API, not duplicated in environment files.
# BANSOKO_QB_PASSWORD=replace-with-a-fixture-password
