# Optional overrides. Nothing here is required: without a .env file the
# defaults in compose.yaml apply. Copy to .env next to compose.yaml and
# uncomment what you want to change.

# Published port of the app.
# BANSOKO_APP_PORT=8000

# Account the app runs as; should match the host account that owns the media
# directories (`id -u` / `id -g`).
# PUID=1000
# PGID=1000
# TZ=Etc/UTC

# Existing PostgreSQL instead of the bundled one. The account must own the
# database and be allowed to create roles (CREATEROLE).
# BANSOKO_DATABASE_URL=postgres://bansoko:password@192.168.1.10:5432/bansoko?sslmode=disable
