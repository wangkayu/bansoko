bansoko-library/
qbittorrent/

# 构建产物
bansoko
bansoko-*
bansoko-server
server
bin/
builds/
tmp/
dist/
frontend/dev-dist/
!frontend/dist/
!frontend/dist/**

# 日志
logs/
*.log

# 数据库
*.db
*.db-journal
*.db-shm
*.db-wal
backups/
data/*.db

# Local config material is not part of the image.
config/
configs/

# Node.js
node_modules/
frontend/node_modules/
frontend/dev-dist/

# Go
vendor/

# IDE
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*~

# 测试
*_test.go
test_*.go

