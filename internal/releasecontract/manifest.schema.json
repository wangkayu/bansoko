{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bansoko.local/release/manifest.schema.json",
  "title": "Bansoko release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_sequence", "release_id", "version", "channel", "published_at", "source_commit", "api_contract_version", "target_migration_version", "required_downtime", "backup_required", "rollback_class", "migrations", "images", "compose_ref", "frontend_ref", "artifacts", "sbom_ref", "provenance_ref", "artifact_digest", "signature", "immutable", "embedded_update"],
  "properties": {
    "schema_version": {"const": "release-manifest-1"},
    "release_sequence": {"type": "integer", "minimum": 1},
    "release_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "channel": {"enum": ["stable", "beta", "nightly"]},
    "published_at": {"type": "string", "format": "date-time"},
    "source_commit": {"type": "string", "minLength": 7},
    "api_contract_version": {"type": "string", "minLength": 1},
    "target_migration_version": {"type": "string", "minLength": 1},
    "compatible_from_versions": {"type": "array", "items": {"type": "string"}},
    "required_downtime": {"type": "boolean"},
    "backup_required": {"type": "boolean"},
    "rollback_class": {"enum": ["code_only", "restore_required", "unsupported"]},
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "checksum", "reversible", "compatibility"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "checksum": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "reversible": {"const": false},
          "compatibility": {"type": "string", "minLength": 1}
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest", "platform"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
          "platform": {"type": "string", "minLength": 1}
        }
      }
    },
    "compose_ref": {"type": "string", "minLength": 1},
    "frontend_ref": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "architecture", "digest", "size", "signature"],
        "properties": {
          "platform": {"type": "string", "minLength": 1},
          "architecture": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "signature": {"type": "string", "minLength": 1},
          "platforms": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "embedded_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_version", "platform", "architecture", "payload_digest", "payload_size", "payload_signature", "bootstrap_min_version", "min_image_version", "target_release_id", "target_version", "target_schema_version", "release_sequence"],
      "properties": {
        "format_version": {"const": "embedded-update-v1"},
        "platform": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "payload_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "payload_size": {"type": "integer", "minimum": 1},
        "payload_signature": {"type": "string", "minLength": 1},
        "bootstrap_min_version": {"type": "string", "minLength": 1},
        "min_image_version": {"type": "string", "minLength": 1},
        "target_release_id": {"type": "string", "minLength": 1},
        "target_version": {"type": "string", "minLength": 1},
        "target_schema_version": {"type": "string", "minLength": 1},
        "release_sequence": {"type": "integer", "minimum": 1}
      },
      "allOf": [{"not": {"required": ["base_image_min_version"]}}]
    },
    "sbom_ref": {"type": "string", "minLength": 1},
    "provenance_ref": {"type": "string", "minLength": 1},
    "artifact_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "signature": {"type": "string", "minLength": 0},
    "immutable": {"const": true},
    "release_notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "published_at", "notes"],
        "properties": {
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "published_at": {"type": "string", "format": "date-time"},
          "notes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh-CN", "en"],
            "properties": {
              "zh-CN": {"type": "string", "minLength": 1},
              "en": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
